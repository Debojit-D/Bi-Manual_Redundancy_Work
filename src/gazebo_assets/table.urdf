<?xml version="1.0"?>
<robot name="table">
  <link name="table_link">
    
    <!-- Table Visual (Appearance in Gazebo) -->
    <visual>
      <origin xyz="5 5 0.4" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gazebo_assets/table.stl" scale="1 1 1"/>
      </geometry>
      <material name="brown">
        <color rgba="0.545 0.271 0.075 1"/>
      </material>
    </visual>

    <!-- Table Collision (Physics interaction) -->
    <collision>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gazebo_assets/table.stl" scale="1 1 1"/>
      </geometry>
    </collision>

    <!-- Table Inertia (Physics properties) -->
    <inertial>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0"
               izz="1.0"/>
    </inertial>
  </link>
</robot>
