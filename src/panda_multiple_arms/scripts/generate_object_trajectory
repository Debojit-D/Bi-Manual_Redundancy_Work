#!/usr/bin/env python3

import rospy
from gazebo_msgs.srv import GetModelState, SetModelState
from gazebo_msgs.msg import ModelState
import numpy as np
import tf.transformations as tf
from visualization_msgs.msg import Marker
from geometry_msgs.msg import Point
from scipy.interpolate import CubicSpline
import csv
import os

def get_table_state():
    """Retrieve the current position and orientation of the table in Gazebo."""
    rospy.wait_for_service('/gazebo/get_model_state')
    try:
        get_model_state = rospy.ServiceProxy('/gazebo/get_model_state', GetModelState)
        table_state = get_model_state('table', 'world')  # Get state in world frame
        
        position = table_state.pose.position
        orientation = table_state.pose.orientation
        
        rospy.loginfo(f"Table Position: x={position.x}, y={position.y}, z={position.z}")
        rospy.loginfo(f"Table Orientation: x={orientation.x}, y={orientation.y}, z={orientation.z}, w={orientation.w}")
        
        return position, orientation
    except rospy.ServiceException as e:
        rospy.logerr(f"Service call failed: {e}")
        return None, None

def slerp_quaternion(start_quat, end_quat, t, t_final):
    """Perform SLERP (Spherical Linear Interpolation) for smooth quaternion transitions."""
    tau = t / t_final
    return tf.quaternion_slerp(start_quat, end_quat, tau)

def generate_position_spline_trajectory(points, total_time, time_step):
    """Generate a smooth position trajectory using cubic spline interpolation."""
    num_points = len(points)
    t_points = np.linspace(0, total_time, num_points)

    # Extract x, y, z components separately
    x_points = [p[0] for p in points]
    y_points = [p[1] for p in points]
    z_points = [p[2] for p in points]

    # Create cubic splines for each component
    x_spline = CubicSpline(t_points, x_points)
    y_spline = CubicSpline(t_points, y_points)
    z_spline = CubicSpline(t_points, z_points)

    # Generate smooth trajectory over time
    t_values = np.arange(0, total_time, time_step)
    position_trajectory = [[x_spline(t), y_spline(t), z_spline(t)] for t in t_values]

    return position_trajectory, t_values

def generate_orientation_trajectory(orientations, t_values, total_time):
    """Generate smooth orientation transitions using SLERP."""
    orientation_trajectory = []
    num_points = len(orientations)

    # Generate orientation trajectory using SLERP between consecutive points
    for i in range(num_points - 1):
        start_orient = orientations[i]
        end_orient = orientations[i + 1]
        segment_time = total_time / (num_points - 1)

        for t in t_values[t_values <= segment_time]:
            interpolated_orientation = slerp_quaternion(start_orient, end_orient, t, segment_time)
            orientation_trajectory.append(interpolated_orientation)

    # Ensure the orientation trajectory has the same number of points as the position trajectory
    while len(orientation_trajectory) < len(t_values):
        orientation_trajectory.append(orientations[-1])

    return orientation_trajectory

def set_table_state(position, orientation):
    """Set the table's position and orientation in Gazebo."""
    rospy.wait_for_service('/gazebo/set_model_state')
    try:
        set_model_state = rospy.ServiceProxy('/gazebo/set_model_state', SetModelState)
        table_state = ModelState()
        table_state.model_name = 'table'
        table_state.pose.position.x = position[0]
        table_state.pose.position.y = position[1]
        table_state.pose.position.z = position[2]
        table_state.pose.orientation.x = orientation[0]
        table_state.pose.orientation.y = orientation[1]
        table_state.pose.orientation.z = orientation[2]
        table_state.pose.orientation.w = orientation[3]
        
        set_model_state(table_state)
        rospy.loginfo(f"Moved table to Position: {position}, Orientation: {orientation}")
    except rospy.ServiceException as e:
        rospy.logerr(f"Service call failed: {e}")

def save_trajectory_to_csv(position, orientation, file_name='/home/iitgn-robotics-1/Debojit_WS/Bi-Manual_Redundancy_Work/src/panda_multiple_arms/scripts/reaching_the_object/table_trajectory.csv'):
    """Save the table's position and orientation to a CSV file."""
    with open(file_name, mode='a', newline='') as file:
        writer = csv.writer(file)
        row = position + orientation.tolist()  # Convert quaternion to list
        writer.writerow(row)

def initialize_csv_file(file_name='table_trajectory.csv'):
    """Initialize the CSV file by overwriting it and writing the header."""
    with open(file_name, mode='w', newline='') as file:
        writer = csv.writer(file)
        writer.writerow(['Position_X', 'Position_Y', 'Position_Z', 'Orientation_X', 'Orientation_Y', 'Orientation_Z', 'Orientation_W'])

def move_table_along_trajectory(position_trajectory, orientation_trajectory, marker_pub, time_step):
    """Move the table along the calculated trajectory and visualize it in RViz."""
    
    marker = Marker()
    marker.header.frame_id = "world"
    marker.type = marker.LINE_STRIP
    marker.action = marker.ADD
    marker.scale.x = 0.01  # Line thickness
    marker.color.a = 1.0   # Opacity
    marker.color.g = 1.0   # Green (trajectory line)

    for i in range(len(position_trajectory)):
        set_table_state(position_trajectory[i], orientation_trajectory[i])

        point = Point()
        point.x = position_trajectory[i][0]
        point.y = position_trajectory[i][1]
        point.z = position_trajectory[i][2]
        marker.points.append(point)

        marker_pub.publish(marker)

        save_trajectory_to_csv(position_trajectory[i], orientation_trajectory[i])

        rospy.sleep(time_step)

def move_table_to_target():
    """Main function to control table movement and publish RViz markers."""
    initialize_csv_file()

    initial_pos, initial_orient = get_table_state()
    if initial_pos is None:
        rospy.logerr("Failed to get initial position of the table.")
        return

    initial_pos_list = [initial_pos.x, initial_pos.y, initial_pos.z]
    mid_point = [initial_pos.x, initial_pos.y, initial_pos.z + 0.3]
    target_position = [initial_pos.x, initial_pos.y, initial_pos.z]

    initial_orient_list = [initial_orient.x, initial_orient.y, initial_orient.z, initial_orient.w]
    mid_orient = [initial_orient.x, initial_orient.y, initial_orient.z, initial_orient.w]
    target_orientation = [initial_orient.x, initial_orient.y, initial_orient.z, initial_orient.w]

    points = [initial_pos_list, mid_point, target_position]
    orientations = [initial_orient_list, mid_orient, target_orientation]

    total_time = 10.0
    time_step = 0.001

    position_trajectory, t_values = generate_position_spline_trajectory(points, total_time, time_step)
    orientation_trajectory = generate_orientation_trajectory(orientations, t_values, total_time)

    marker_pub = rospy.Publisher('/table_trajectory_marker', Marker, queue_size=10)
    
    move_table_along_trajectory(position_trajectory, orientation_trajectory, marker_pub, time_step)

if __name__ == '__main__':
    try:
        rospy.init_node('table_trajectory_mover')
        move_table_to_target()
    except rospy.ROSInterruptException:
        pass
